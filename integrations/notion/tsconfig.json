{
  "extends": "../issue-tracker/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      // Also what devonian's optional @tomic/lib peer resolves to: it is not
      // installed in node_modules/. `syncables` and `devonian` come from npm
      // (package.json, pnpm-lock.yaml; `pnpm install` in this folder).
      "@tomic/lib": ["../../browser/lib/src/index.ts"]
    }
  },
  "include": [
    "model.ts",
    "plugin.ts",
    "atomic.ts",
    "localthought.ts",
    "host/async-plugin.ts",
    "host/browser-sync.ts",
    "app/*.ts"
  ],
  "exclude": ["app/*.test.ts", "app/fakeStore.ts"]
}
